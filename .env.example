# Neon PostgreSQL (development branch)
# Pooled connection - used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection - used by Prisma CLI for migrations (falls back to DATABASE_URL if unset)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Email verification (Resend)
RESEND_API_KEY=
# Optional: sender address (defaults to onboarding@resend.dev) and public app URL used in email links
EMAIL_FROM=
APP_URL=
